{
  "redirects": [
    { "source": "/partners", "destination": "/industry", "type": 301 },
    { "source": "/apply", "destination": "/homes/apply", "type": 301 },
    { "source": "/products", "destination": "/", "type": 301 },
    { "source": "/services", "destination": "/commercial", "type": 301 },
    { "source": "/learn", "destination": "/", "type": 301 },
    { "source": "/faq", "destination": "/contact", "type": 301 },
    { "source": "/book-call", "destination": "/contact", "type": 301 },
    { "source": "/case-studies", "destination": "/", "type": 301 },
    { "source": "/portfolio", "destination": "/", "type": 301 },
    { "source": "/newsroom", "destination": "/about", "type": 301 },
    { "source": "/newsroom/:path*", "destination": "/about", "type": 301 },
    { "source": "/blog", "destination": "/about", "type": 301 },
    { "source": "/blog/:path*", "destination": "/about", "type": 301 },
    { "source": "/education", "destination": "/", "type": 301 },
    { "source": "/calculators", "destination": "https://calc.exergyheat.com", "type": 301 },
    { "source": "/docs", "destination": "https://docs.exergyheat.com", "type": 301 }
  ],
  "rewrites": [
    { "source": "**", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "**",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://umami.denver.space; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' https://umami.denver.space; frame-src https://cal.com https://app.cal.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "assets/**",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
